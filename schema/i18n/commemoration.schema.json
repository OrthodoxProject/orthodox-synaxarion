{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commemoration (locale)",
  "description": "Title and texts of a commemoration in one language (data/i18n/<locale>/commemorations/<id>.json). Official titles used by a particular Church live in that tradition's locale file.",
  "type": "object",
  "properties": {
    "id": { "$ref": "../common/defs.schema.json#/$defs/slug" },
    "locale": { "$ref": "../common/defs.schema.json#/$defs/locale" },
    "names": {
      "type": "object",
      "$ref": "common.schema.json#/$defs/names",
      "properties": {
        "folk": {
          "description": "Popular names of the feast (e.g. 'Boboteaza', 'Sânmedru').",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/text" },
          "uniqueItems": true
        }
      },
      "unevaluatedProperties": false
    },
    "summary": { "$ref": "common.schema.json#/$defs/text" },
    "synaxarion": { "$ref": "common.schema.json#/$defs/text" },
    "folk_traditions": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/attributedText" }
    },
    "references": { "$ref": "common.schema.json#/$defs/references" },
    "translation": { "$ref": "common.schema.json#/$defs/translation" }
  },
  "required": ["id", "locale", "names", "translation"],
  "additionalProperties": false
}
