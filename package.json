{
  "name": "orthodox-synaxarion",
  "version": "0.1.0",
  "private": true,
  "description": "Open, structured, multilingual synaxarion of the Orthodox Churches: JSON data, JSON Schema and tooling.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "validate": "node tools/validate.ts",
    "format": "node tools/format.ts",
    "generate": "node tools/generate.ts",
    "wiki": "node tools/wiki.ts",
    "import": "node tools/import.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p site",
    "check": "npm run typecheck && npm test && npm run validate",
    "site:dev": "astro dev --root site",
    "site:build": "astro build --root site && pagefind --site build/site",
    "site:preview": "astro preview --root site"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "astro": "^7.4.7",
    "marked": "^18.1.3",
    "pagefind": "^1.6.0",
    "typescript": "^7.0.2"
  }
}
