{
  "name": "orthodox-synaxarion",
  "version": "0.1.0",
  "private": true,
  "description": "Open, structured, multilingual synaxarion of the Orthodox Churches: JSON data, JSON Schema and tooling.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "validate": "node tools/validate.ts",
    "format": "node tools/format.ts",
    "generate": "node tools/generate.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run validate"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
