---
import Base from "../../../layouts/Base.astro";
import { CALENDAR_IDS, calendarDate, calendarDoc, calendarHtml, type CalendarId } from "../../../lib/calendars.ts";
import { dateText } from "../../../lib/format.ts";
import { href, todayIso } from "../../../lib/site.ts";
import { LANGS, t, type Lang } from "../../../lib/ui.ts";

export function getStaticPaths() {
  return LANGS.flatMap((lang) => CALENDAR_IDS.map((id) => ({ params: { lang, id } })));
}

const lang = Astro.params.lang as Lang;
const id = Astro.params.id as CalendarId;
const doc = calendarDoc(id, lang);
const today = todayIso();
const value = calendarDate(id, today, lang);
---

<Base lang={lang} title={doc.title} description={doc.summary} segments={["calendars", id]}>
  <p class="crumbs"><a href={href(lang, "calendars")}>{t(lang, "calendars")}</a></p>
  <article class="calendar-page" data-pagefind-body data-pagefind-filter={`type:${t(lang, "calendars")}`}>
    <h1>{doc.title}</h1>
    <p class="summary">{doc.summary}</p>
    {
      value && (
        <p class="calendar-today" data-pagefind-ignore>
          <span class="muted">{t(lang, "calendarsToday", { date: dateText(today, lang) })}:</span> {value.text}
          {value.detail && <span class="muted"> · {value.detail}</span>}
          {value.native && " "}
          {value.native && (
            <span class="native" lang={value.native.lang} dir={value.native.dir}>
              {value.native.text}
            </span>
          )}
        </p>
      )
    }
    <Fragment set:html={calendarHtml(doc.body, lang)} />
  </article>
</Base>
