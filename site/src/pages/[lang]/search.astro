---
import Base from "../../layouts/Base.astro";
import { asset, href } from "../../lib/site.ts";
import { LANGS, t, type Lang } from "../../lib/ui.ts";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<Base lang={lang} title={t(lang, "search")} segments={["search"]} current="search">
  <h1>{t(lang, "search")}</h1>
  <p class="muted">{t(lang, "searchIntro")}</p>
  <link rel="stylesheet" href={asset("pagefind/pagefind-component-ui.css")} />
  <script is:inline type="module" src={asset("pagefind/pagefind-component-ui.js")}></script>
  <!-- The index of the page's language is chosen from <html lang>. -->
  <div id="search" class="search">
    <pagefind-config base-url={href()} bundle-path={asset("pagefind/")}></pagefind-config>
    <pagefind-input autofocus></pagefind-input>
    <pagefind-filter-dropdown filter="type" label={t(lang, "kind")} single-select></pagefind-filter-dropdown>
    <pagefind-summary></pagefind-summary>
    <pagefind-results></pagefind-results>
  </div>
  <script is:inline type="module">
    // Runs after the component script: search for ?q= from the address.
    const query = new URLSearchParams(location.search).get("q");
    if (query) window.PagefindComponents?.getInstanceManager().getInstance("default").triggerSearch(query);
  </script>
</Base>
