---
import Facts from "../../../components/Facts.astro";
import Hymns from "../../../components/Hymns.astro";
import Placements from "../../../components/Placements.astro";
import Provenance from "../../../components/Provenance.astro";
import Texts from "../../../components/Texts.astro";
import Base from "../../../layouts/Base.astro";
import { commName, holinessText, languageNotice, linkOf, localeOf, nameOf, vocab } from "../../../lib/format.ts";
import { redirectPage } from "../../../lib/redirect.ts";
import { aliasesOf, commemorationsOf, href, idsOf, record } from "../../../lib/site.ts";
import { LANGS, t, type Lang } from "../../../lib/ui.ts";

export function getStaticPaths() {
  return LANGS.flatMap((lang) => [
    ...idsOf("groups").map((id) => ({ params: { lang, id } })),
    ...aliasesOf("groups").map(({ alias, id }) => ({ params: { lang, id: alias }, props: { movedTo: `group:${id}` } })),
  ]);
}

type Rec = Record<string, any>;
const lang = Astro.params.lang as Lang;
// The old address of a former id leads to the group's page.
const { movedTo } = Astro.props as { movedTo?: string };
if (movedTo) return redirectPage(movedTo, lang);
const id = Astro.params.id as string;
const ref = `group:${id}`;
const rec = record("groups", id) as Rec;
const loc: Rec = localeOf("groups", id, lang) ?? { names: { display: id } };
const self = href(lang, "groups", id);
const comms = commemorationsOf(ref);
const members = (rec.members ?? []) as Rec[];
const holiness = (rec.holiness_types ?? []) as string[];
const notice = languageNotice(loc, lang);
---

<Base lang={lang} title={loc.names.display} description={loc.summary} segments={["groups", id]} current="saints">
  <p class="crumbs"><a href={href(lang, "saints")}>{t(lang, "saints")}</a> · {t(lang, "groups")}</p>
  <article data-pagefind-body data-pagefind-filter={`type:${t(lang, "groups")}`}>
    <h1>{loc.names.full ?? loc.names.display}</h1>
    <p class="lead">
      {[vocab(lang, `group_kind.${rec.kind}`), holiness.map((h) => vocab(lang, `holiness_type.${h}`, "m.pl")).join(", ")].filter(Boolean).join(" · ")}
    </p>
    {rec.editorial?.status === "draft" && <p class="draft" data-pagefind-ignore>{t(lang, "draft")}</p>}
    {notice && <p class="muted" data-pagefind-ignore>{notice}</p>}
    {loc.summary && <p class="summary" lang={loc.locale !== lang ? loc.locale : undefined}>{loc.summary}</p>}

    {
      members.length > 0 && (
        <section>
          <h2>{t(lang, "members")}</h2>
          <ul class="lines">
            {members.map((m) => {
              const person = record("persons", m.person.slice("person:".length));
              const kinds = (person?.holiness_types ?? []) as string[];
              return (
                <li>
                  <a href={linkOf(m.person, lang)}>{nameOf(m.person, lang)}</a>
                  {m.role === "leader" && <small class="muted"> · {t(lang, "leader")}</small>}
                  {kinds.length > 0 && <small class="muted"> · {holinessText(kinds, person?.gender, lang)}</small>}
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    {
      comms.length > 0 && (
        <section>
          <h2>{t(lang, "celebratedOn")}</h2>
          {comms.map((c) => {
            const link = linkOf(c, lang);
            return (
              <div class="comm">
                <h3>{link && link !== self ? <a href={link}>{commName(c, lang)}</a> : commName(c, lang)}</h3>
                <Placements comm={c} lang={lang} />
              </div>
            );
          })}
        </section>
      )
    }

    <section>
      <h2>{t(lang, "facts")}</h2>
      <Facts rec={rec} loc={loc} lang={lang} />
    </section>

    <Texts collection="groups" id={id} loc={loc} lang={lang} />
    <Hymns refs={comms} lang={lang} />
  </article>
  <Provenance collection="groups" id={id} rec={rec} loc={loc} lang={lang} />
</Base>
